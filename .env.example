# Copy to .env. Do not commit .env. Do not bake this file's values into the image.
#
# 1. Generate a high-entropy SECRET_KEY and paste it below:
#      python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# 2. Phase A self-test may temporarily set AUTH_TEST_CODE=000000.
#    Production must leave it empty (or unset).
# 3. Do not set ALLOW_INSECURE_DEFAULTS here or in the image.
#    That switch is only for non-compose local development.

SECRET_KEY=
AUTH_TEST_CODE=
COOKIE_SECURE=

STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
DATABASE_URL=sqlite:////data/app.db

# Used only when STORAGE_BACKEND=s3. Leave blank for the default local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=

# Export packaging. Uncomment to override. The browser waits this many seconds plus 10.
# EXPORT_BUILD_TIMEOUT_S=120
# Directory for in-progress zip files. Default is the system temp dir.
# EXPORT_TEMP_DIR=
# Blob downloads larger than this many MiB use the browser download instead.
# EXPORT_BLOB_MAX_MB=200
# Filename date when ?d=YYYY-MM-DD is missing or not a real date.
# EXPORT_FILENAME_TZ=Asia/Shanghai
